# Integration tests (uv run python test_integration.py)
DAYTONA_API_KEY=
# Optional image and region for disposable Daytona test sandboxes.
# LATHE_TEST_IMAGE=
# LATHE_TEST_REGION=

# Local Docker monitor and demo. Export both provider keys before running;
# these runners do not load .env themselves.
OPENROUTER_API_KEY=

# Deployment tests (uv run python test_deployment.py)
OWUI_URL=https://your-owui-instance.example.com
# Setup/inspection/cleanup administrator credential, never used for completions.
OWUI_TOKEN=
# Dedicated ordinary test user's session token and expected email. No fallback to
# the administrator. Give this account model access but no other local toolkits.
OWUI_TEST_TOKEN=
OWUI_TEST_EMAIL=lathe-test@your-domain.example
OWUI_MODEL=your-connection/provider/model-id
# Optional; defaults to the isolated staging toolkit ID lathe_test.
LATHE_TEST_TOOL_ID=lathe_test

# Optional live preview-wrapper deployment contract
LATHE_PREVIEW_WRAPPER_URL=https://previews.example.com/register
LATHE_PREVIEW_WRAPPER_KEY=
LATHE_PREVIEW_EXPECTED_PATTERN=https://lathe-[a-z0-9]+\.previews\.example\.com/
LATHE_PREVIEW_REVOKE_URL=https://previews.example.com/register/{label}
LATHE_PREVIEW_ACCESS=private

# Run demo_local.py for video capture. It supplies the disposable browser's
# DEMO_* settings; no hosted demo credentials are needed.
