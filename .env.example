# Integration tests (uv run python test_integration.py)
DAYTONA_API_KEY=

# Deployment tests (uv run python test_deployment.py)
OWUI_URL=https://your-owui-instance.example.com
OWUI_TOKEN=
OWUI_MODEL=your-connection/provider/model-id
# Optional; defaults to the isolated staging toolkit ID lathe_test.
LATHE_TEST_TOOL_ID=lathe_test

# Optional live preview-wrapper deployment contract
LATHE_PREVIEW_WRAPPER_URL=https://previews.example.com/register
LATHE_PREVIEW_WRAPPER_KEY=
LATHE_PREVIEW_EXPECTED_PATTERN=https://lathe-[a-z0-9]+\.previews\.example\.com/
LATHE_PREVIEW_REVOKE_URL=https://previews.example.com/register/{label}
LATHE_PREVIEW_ACCESS=private

# Demo video capture only (demo-video/capture.mjs)
DEMO_OWUI_URL=https://your-owui-instance.example.com
# Serialized Playwright virtual authenticator credential. Keep this secret out
# of version control: it includes the dedicated demo account's private key.
DEMO_PASSKEY=
# Optional when OWUI_MODEL above is the model you want to record.
DEMO_MODEL=your-connection/provider/model-id
# Comma-separated hostnames accepted when opening the generated preview link.
# Add the preview-wrapper hostname when owner-authenticated previews are enabled.
DEMO_PROXY_DOMAINS=daytonaproxy01.net,proxy.app.daytona.io,proxy.daytona.work
