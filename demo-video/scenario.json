{
  "id": "lathe-everyday-infographic",
  "version": 11,
  "steps": [
    { "id": "auth.owui", "do": "auth.ensure-owui", "failureDomain": "authentication" },
    { "id": "capture.start", "do": "capture.start" },
    { "id": "chat.open", "do": "chat.open", "screenshot": "fresh-chat", "failureDomain": "ui_drift" },
    { "id": "lathe.enable", "do": "owui.enable-tool", "screenshot": "lathe-enabled", "failureDomain": "ui_drift" },
    {
      "id": "infographic.request", "do": "chat.send", "failureDomain": "model_behavior",
      "with": {
        "prompt": "Here's our repair-café log. Make an HTML infographic showing the volunteers what we accomplished and where we could improve. Ground factual claims in these records, distinguish repairs from advice, and label suggestions as suggestions.",
        "dataFile": "repair-log.csv", "timeoutMs": 420000
      }
    },
    {
      "id": "preview.request", "do": "chat.send", "failureDomain": "model_behavior",
      "with": { "prompt": "Serve it up, private.", "timeoutMs": 180000 }
    },
    {
      "id": "preview.prove", "do": "chat.await-tool-result", "screenshot": "private-preview-ready", "failureDomain": "lathe_behavior",
      "with": { "tools": ["expose"], "argumentsEqual": { "access": "private" }, "outputContains": "Copying the URL does not grant access." }
    },
    { "id": "infographic.prove", "do": "chat.find-artifact", "failureDomain": "lathe_behavior" },
    { "id": "preview.open", "do": "preview.open", "screenshot": "repair-cafe-infographic", "failureDomain": "ui_drift" },
    { "id": "closing.hold", "do": "camera.hold", "with": { "milliseconds": 6000 } }
  ]
}
